<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#D9D8D5">


    <!-- =========================================================
         BACKGROUND WATERMARK
         ========================================================= -->

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="300dp"
        android:layout_height="520dp"
        android:alpha="0.07"
        android:contentDescription="Background"
        android:scaleType="fitXY"
        android:src="@drawable/dashbg3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:background="@color/main_grey"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- Gold bottom line -->

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_alignParentBottom="true"
            android:background="#DCB765" />


        <!-- =====================================================
             LOGO
             ===================================================== -->

        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:background="@drawable/dashboard_logo_circle1"
            android:elevation="10dp"
            android:padding="5dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="GPIL Logo"
                android:scaleType="centerInside"
                android:src="@drawable/logooo" />

        </FrameLayout>


        <!-- =====================================================
             TITLE
             ===================================================== -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/logoContainer"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dispatch"
                android:textColor="#FFF8E8"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sub_tittle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="(Header Info)"
                android:textColor="#DCB765"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- =====================================================
             ORG + DATE
             ===================================================== -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/orgLLt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ORG : "
                    android:textColor="#DCB765"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_org_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFF8E8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/dateLLt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date : "
                    android:textColor="#DCB765"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFF8E8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>


    <!-- =========================================================
         BODY
         ========================================================= -->

    <ScrollView
        android:id="@+id/bodyScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">


            <!-- =================================================
                 WEIGHMENT
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb20Weighment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#DCB765"
                    android:text="20% Weighment"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rb100Weighment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#DCB765"
                    android:text="100% Weighment"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- =================================================
                 SENDER ORG
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Sender.Org :"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSenderOrg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- =================================================
                 RECEIVER ORG
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Rec.Org :"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spRecOrg"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp" />

            </LinearLayout>


            <!-- =================================================
                 TRUCK NO
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Truck No"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTruckNo"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#2E353A"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- =================================================
                 RC NO
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="RC No"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtRcNo"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#2E353A"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- =================================================
                 DRIVER NAME
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Driver Name"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtDriverName"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:inputType="textPersonName"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#2E353A"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- =================================================
                 DRIVER LICENSE
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Driver License"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtDriverLicense"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#2E353A"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- =================================================
                 TRANSPORT NAME
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Transporter Name"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spTransporterName"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp" />

            </LinearLayout>


            <!-- =================================================
                 TRANSPORTER NAME
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Type of Truck"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spTypeofTruck"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp" />

            </LinearLayout>


            <!-- =================================================
                 FREIGHT TYPE
                 ================================================= -->



            <!-- =================================================
                 FREIGHT CHARGES
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Freight Charges"
                    android:textColor="#2E353A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtFreightCharges"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#2E353A"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="/Kg"
                    android:textColor="#A87818"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- SAVE -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="SAVE"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="normal"
            android:textAllCaps="false"
            android:background="@drawable/save_button_background"
            android:backgroundTint="@null"
            app:backgroundTint="@null" />


        <!-- CLEAR -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="CLEAR"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="normal"
            android:textAllCaps="false"
            android:background="@drawable/clear_button_background"
            android:backgroundTint="@null"
            app:backgroundTint="@null" />
    </LinearLayout>


    <!-- =========================================================
         FLOATING BACK BUTTON
         ========================================================= -->

    <FrameLayout
        android:id="@+id/syncButtonContainer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="62dp"
        android:background="@drawable/sync_button_background"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnSync"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Sync"
            android:scaleType="fitCenter"
            android:src="@drawable/arrow_back"
            android:tint="#DCB765"
            />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>