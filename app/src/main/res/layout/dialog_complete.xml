<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="28dp">

    <LinearLayout
        android:id="@+id/completeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_complete_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <com.united.digitaldispatch.utils.CompleteCheckView
            android:id="@+id/completeCheck"
            android:layout_width="200dp"
            android:layout_height="190dp" />

        <TextView
            android:id="@+id/txtCompleteTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:gravity="center"
            android:textColor="#1F2D26"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCompleteMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:gravity="center"
            android:textColor="#5F6F66"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtCompleteDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0"
            android:background="@drawable/bg_complete_chip"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="#1B5E20"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtCompleteOk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:alpha="0"
            android:background="@drawable/bg_complete_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>