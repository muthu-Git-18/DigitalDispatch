<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loaderCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_loader_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp">

        <!-- faint static track -->
        <View
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_loader_ring_track" />

        <!-- spinning comet ring -->
        <View
            android:id="@+id/loaderRing"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_loader_ring" />

        <ImageView
            android:id="@+id/loaderTruck"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:contentDescription="Loading"
            android:src="@drawable/ic_loader_truck" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvLoaderMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="#FFF8E8"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Please wait"
        android:textColor="#DCB765"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>