<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/successCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_confirm_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp">

        <View
            android:id="@+id/successRipple1"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_success_ripple" />

        <View
            android:id="@+id/successRipple2"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_success_ripple" />

        <View
            android:id="@+id/successCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_success_circle"
            android:elevation="6dp" />

        <ImageView
            android:id="@+id/successCheck"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="Success"
            android:elevation="8dp"
            android:src="@drawable/ic_success_check" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvSuccessTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="#2E353A"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSuccessSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#A47C3C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/successTimer"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="22dp"
        android:background="#DCB765" />

</LinearLayout>