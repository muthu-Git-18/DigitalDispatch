<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/txt_sno"
        android:layout_width="50dp" android:layout_height="42dp"
        android:background="@drawable/table_cell" android:gravity="center"
        android:textColor="#85745E" android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_bale_no"
        android:layout_width="150dp" android:layout_height="42dp"
        android:background="@drawable/table_cell" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textColor="#2E353A" android:textSize="12sp" android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_mrkd_weight"
        android:layout_width="90dp" android:layout_height="42dp"
        android:background="@drawable/table_cell" android:gravity="center"
        android:textColor="#2E353A" android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_dispatch_wt"
        android:layout_width="90dp" android:layout_height="42dp"
        android:background="@drawable/table_cell" android:gravity="center"
        android:textColor="#2E353A" android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_ship_no"
        android:layout_width="80dp" android:layout_height="42dp"
        android:background="@drawable/table_cell" android:gravity="center"
        android:textColor="#2E353A" android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_created_date"
        android:layout_width="110dp" android:layout_height="42dp"
        android:background="@drawable/table_cell" android:gravity="center"
        android:textColor="#2E353A" android:textSize="12sp" />
</LinearLayout>