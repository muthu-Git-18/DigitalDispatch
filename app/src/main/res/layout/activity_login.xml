<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/login_background1">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- =========================================================
                 LOGIN CARD
                 ========================================================= -->

            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:background="@drawable/login_card_background"
                android:elevation="12dp"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <!-- =====================================================
                     LOGO
                     ===================================================== -->

                <ImageView
                    android:id="@+id/imgBgLogo"
                    android:layout_width="120dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="Company logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logooo" />

                <!-- =====================================================
                     LOGIN TITLE
                     ===================================================== -->

                <ImageView
                    android:id="@+id/imgLoginTitle"
                    android:layout_width="220dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:contentDescription="Login"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logoo" />

                <!-- =====================================================
                     SUBTITLE
                     ===================================================== -->

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:text="A Legacy of Quality and Trust"
                    android:textColor="#8B7256"
                    android:textSize="13sp" />

                <!-- =====================================================
                     FORM
                     ===================================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginEnd="26dp"
                    android:orientation="vertical">

                    <!-- EMPLOYEE / PARTNER ID -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Employee icon"
                            android:src="@drawable/ic_person"
                            app:tint="#A47C3C" />

                        <EditText
                            android:id="@+id/etEmployee"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Employee / Partner ID or Email"
                            android:inputType="text"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="#2E2418"
                            android:textColorHint="#B5A483"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- PASSWORD -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/input_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Password icon"
                            android:src="@drawable/ic_lock"
                            app:tint="#A47C3C" />

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Password"
                            android:inputType="textPassword"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="#2E2418"
                            android:textColorHint="#B5A483"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/imgShowPassword"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Toggle password visibility"
                            android:src="@drawable/ic_eye"
                            app:tint="#A47C3C" />

                    </LinearLayout>

                    <!-- DROPDOWN ONE -->

                    <LinearLayout
                        android:id="@+id/dropdownOne"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/input_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tvDropdownOne"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Select Company"
                            android:textColor="#5A4630"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Expand"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="#A47C3C" />

                    </LinearLayout>

                    <!-- DROPDOWN TWO -->

                    <LinearLayout
                        android:id="@+id/dropdownTwo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/input_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tvDropdownTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Select Branch"
                            android:textColor="#5A4630"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Expand"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="#A47C3C" />

                    </LinearLayout>

                    <!-- SECURE LOGIN -->

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/login_button_background1"
                        android:backgroundTint="@null"
                        android:elevation="4dp"
                        android:text="Secure Login"
                        android:textAllCaps="false"
                        android:textColor="#2E2418"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- =========================================================
                 COPYRIGHT
                 ========================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="© 2026 All Rights Reserved"
                android:textColor="#B8AA8C"
                android:textSize="11sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>