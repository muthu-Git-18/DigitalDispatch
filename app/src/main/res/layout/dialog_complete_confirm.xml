<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="28dp">

    <LinearLayout
        android:id="@+id/askCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_complete_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <com.united.digitaldispatch.utils.ConfirmQuestionView
            android:id="@+id/askIcon"
            android:layout_width="150dp"
            android:layout_height="130dp" />

        <TextView
            android:id="@+id/txtAskTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:gravity="center"
            android:textColor="#1F2D26"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAskMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:gravity="center"
            android:textColor="#5F6F66"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtAskDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0"
            android:letterSpacing="0.04"
            android:textColor="#A47C3C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/askStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAskNo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:alpha="0"
                android:background="@drawable/bg_ask_btn_no"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textAllCaps="false"
                android:textColor="#5F6F66"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAskYes"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1.3"
                android:alpha="0"
                android:background="@drawable/bg_ask_btn_yes"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>