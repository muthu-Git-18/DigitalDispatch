<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/txt_grade"
        android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1.4"
        android:background="@drawable/table_cell" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textColor="#2E353A" android:textSize="12sp" android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_bales"
        android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="0.8"
        android:background="@drawable/table_cell" android:gravity="center"
        android:textColor="#2E353A" android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_qty"
        android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
        android:background="@drawable/table_cell" android:gravity="center"
        android:textColor="#2E353A" android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_rate"
        android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
        android:background="@drawable/table_cell" android:gravity="center"
        android:textColor="#2E353A" android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_value"
        android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1.2"
        android:background="@drawable/table_cell" android:gravity="center"
        android:textColor="#2E353A" android:textSize="12sp" />
</LinearLayout>