<?xml version="1.0" encoding="utf-8"?>
<!--
    Soft circular backdrop behind the hourglass icon, for a friendlier
    "badge" look instead of the icon floating bare on the card.
    Put this file at: res/drawable/bg_hourglass_circle.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <solid android:color="#FBF1DC" />

    <stroke
        android:width="1dp"
        android:color="#E7CE93" />

</shape>