<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark depth -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">

        <shape android:shape="oval">

            <solid android:color="#1F2529" />

            <stroke
                android:width="2dp"
                android:color="#80602F" />

        </shape>

    </item>


    <!-- Main gold outer ring -->
    <item
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="oval">

            <gradient
                android:angle="270"
                android:startColor="#F3DFA8"
                android:centerColor="#DCB765"
                android:endColor="#9A6D32" />

            <stroke
                android:width="1dp"
                android:color="#6B4A25" />

        </shape>

    </item>


    <!-- Inner dark ring -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="7dp"
        android:bottom="7dp">

        <shape android:shape="oval">

            <solid android:color="#2E353A" />

            <stroke
                android:width="1dp"
                android:color="#F3DFA8" />

        </shape>

    </item>

</layer-list>