<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded background for the searchable spinner dialog card.
    Put this file at: res/drawable/bg_spinner_dialog.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FFFDF8" />

    <stroke
        android:width="1.5dp"
        android:color="#D9A441" />

    <corners android:radius="22dp" />

    <padding
        android:left="20dp"
        android:top="22dp"
        android:right="20dp"
        android:bottom="16dp" />

</shape>