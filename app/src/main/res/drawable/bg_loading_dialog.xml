<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded background for the "Items And Stock Loading" dialog card.
    Put this file at: res/drawable/bg_loading_dialog.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FFFDF8" />

    <stroke
        android:width="1.5dp"
        android:color="#D9A441" />

    <corners android:radius="28dp" />

    <padding
        android:left="28dp"
        android:top="28dp"
        android:right="28dp"
        android:bottom="28dp" />

</shape>